# Atlas Academy — Environment Variables
# Copy this file to `.env` for local development.
# On Vercel, set these in Project Settings → Environment Variables.

# ============================================================================
# DATABASE_URL (required)
# The connection string Prisma uses for queries.
#
# LOCAL DEV (PostgreSQL):
#   Install Postgres locally, then:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlas_academy
#
# VERCEL (Vercel Postgres):
#   1. Go to your Vercel project → Storage → Create Database → Postgres
#   2. Copy the " pooled" connection string (ends with ?pgbouncer=true)
#   3. Set as DATABASE_URL on Vercel
#
# VERCEL (Neon — free tier, recommended):
#   1. Sign up at https://neon.tech
#   2. Create a project, copy the connection string
#   3. Set as DATABASE_URL on Vercel
#
# VERCEL (Supabase — free tier):
#   1. Sign up at https://supabase.com
#   2. Create a project → Settings → Database → Connection string (URI)
#   3. Set as DATABASE_URL on Vercel
# ============================================================================
DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=true&connection_limit=1"

# ============================================================================
# DIRECT_URL (required for Vercel Postgres with PgBouncer pooling)
# A non-pooled connection string Prisma uses for migrations and CLI commands.
# If you're NOT using Vercel Postgres (e.g. Neon without PgBouncer),
# you can set this to the same value as DATABASE_URL.
# ============================================================================
DIRECT_URL="postgresql://user:password@host:5432/database"
