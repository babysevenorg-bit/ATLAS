# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Production
*.tsbuildinfo
next-env.d.ts

# Environment variables (contains DATABASE_URL — never commit)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database (SQLite local file — root /db/ directory only.
# The leading "/" is critical: "db/" would also exclude src/db/
# which contains the Prisma client code.)
/db/
*.db
*.db-journal

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lockb
dev.log
server.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Uploads (user-provided source files — not part of the app)
upload/
tool-results/

# Sandbox skill definitions (not part of the deployed app)
skills/

# Sandbox test scripts
tests/

# Agent browser / sandbox artifacts
.zscripts/dev.log
.zscripts/dev.pid
agent-ctx/

# Vercel CLI local config
.vercel/
